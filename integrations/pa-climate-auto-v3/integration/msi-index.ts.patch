--- index.ts.before
+++ index.ts
@@ -283,0 +284,15 @@
+// Farmplast Climate: single store in the existing main worker; no extra listener.
+const climateReady = (async () => {
+  const { loadConfig } = await import('./climate/module/server/config.mjs')
+  const { createClimateFetch } = await import('./climate/module/integration/fetch-existing-runtime.mjs')
+  const c = loadConfig('/home/deno/functions/main/climate/runtime.env')
+  const climate = createClimateFetch({dir:c.DATA_DIR,adminKey:c.CLIMATE_ADMIN_KEY,publicOrigin:c.PUBLIC_ORIGIN,
+    installerSourceDir:'/home/deno/functions/main/climate/module',
+    authUrl:c.FARMPLAST_AUTH_URL,authAnonKey:c.FARMPLAST_AUTH_ANON_KEY,allowedUserIds:c.FARMPLAST_ALLOWED_USER_IDS})
+  if(c.PA_CLIMATE_TRANSPORT_KEY) {
+    const {startMsiTransport} = await import('./climate/module/integration/realtime-https-transport.mjs')
+    startMsiTransport({supabaseUrl:c.FARMPLAST_AUTH_URL,anonKey:c.FARMPLAST_AUTH_ANON_KEY,secret:c.PA_CLIMATE_TRANSPORT_KEY}, req=>climate.route(req),{onState:state=>console.log('Farmplast Climate transport:',state)})
+  }
+  return climate
+})().catch(e => { console.error('Climate initialization failed:', e.message); return null })
+
@@ -284,0 +300,8 @@
+  const climatePath = new URL(req.url).pathname
+  if (climatePath === '/climate' || climatePath.startsWith('/climate/') || climatePath.startsWith('/climate-local/')) {
+    const climate = await climateReady
+    if (!climate) return Response.json({error:'Climate module unavailable'}, {status:503})
+    try { return await climate.route(req) }
+    catch(e) { console.error('Climate request failed:', e.message); return Response.json({error:'Climate request failed'}, {status:500}) }
+  }
